programa TodosOsTokens
// Exercita todas as categorias de token da Colombe (programa válido)

const LADO: int = 3
const PI: real = 3.14159

var tabuleiro: matriz[LADO][LADO] de caractere

modulo potenciaMod(base: int, exp: int, m: int): int
	retorna (base ^ exp) mod m
fim

inicio
	var a: int = 10
	var b: int = -5
	var x: real = 2.5
	var ok: logico = verdadeiro
	var letra: caractere = 'A'
	var nl: caractere = '\n'
	var aspas: cadeia = "Ela disse: \"oi\"\tfim"

	/* comentário de bloco
	   em várias linhas */

	// aritméticos: + - * / ^ div mod e menos unário
	a = a + b * 2 - -a
	x = a / 4
	b = a div 3 + a mod 3 + 2 ^ 3 ^ 2

	// incremento e decremento pré e pós-fixados
	a++
	--b
	a = a++ + ++a - a-- - --a

	// relacionais e lógicos
	ok = (a == b) ou (a != b) e nao (a < b)
	ok = (a <= b) xou (a >= b) ou (a > b) ou falso

	se ok entao
		escreve("ok\n")
	senao
		escreve("não ok\n")
	fimse

	enquanto a > 0 faca
		a--
	fimenquanto

	repita
		leia(a)
	ate a >= 0

	para a de 0 ate LADO - 1 passo 1 faca
		tabuleiro[a][a] = 'X'
	fimpara

	escreve("Resultado: ", potenciaMod(2, 10, 7), letra, nl, aspas, PI * x)
fim
